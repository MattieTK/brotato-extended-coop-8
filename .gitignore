Thumbs.db
.DS_Store
.vscode/

# The release zip in workshop/ is a build artifact regenerated by
# workshop_build.ps1. It is kept in the repo as the ready-to-upload file,
# but ignore stray zips built elsewhere.
/*.zip
mods-unpacked/**/*.zip
